<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================== PERMISSÕES ============================== -->

    <!-- Rede: o app conecta via TCP ao Mac (servidor) na LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service (necessário p/ manter captura ativa em background). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34): tipo específico p/ MediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Áudio do dispositivo (opcional/gated): captura de playback via MediaProjection (API 29+). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 14+ (API 34): tipo específico p/ FGS de microfone (necessário quando capturamos áudio). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notificação do foreground service (runtime na API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Câmera: usada APENAS para ler o QR de pareamento. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".DanteCastApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DanteCast"
        tools:targetApi="35">

        <!-- Activity única que hospeda toda a navegação Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:label="@string/app_name"
            android:theme="@style/Theme.DanteCast">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================== FOREGROUND SERVICE ============================== -->
        <!--
            ScreenMirrorService: roda a captura + encoder + cliente TCP.
            foregroundServiceType="mediaProjection" é OBRIGATÓRIO no Android 14+.
            stopWithTask=false: deixamos o usuário parar explicitamente (notificação/STOP).
        -->
        <service
            android:name=".service.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone"
            android:stopWithTask="true" />

    </application>

</manifest>
