<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de extração de dados (Android 12+, API 31+).
    Não há dados sensíveis persistidos além de settings; permitimos backup padrão.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exemplo: excluir tokens/segredos de backup, caso passem a ser persistidos. -->
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
